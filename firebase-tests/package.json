{
  "name": "amanah-kasir-firebase-tests",
  "private": true,
  "type": "module",
  "description": "Tes Security Rules (Firestore + Storage) di Firebase Emulator",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --project demo-amanah-kasir --only firestore,storage \"node --test\"",
    "smoke": "firebase emulators:exec --config ../firebase.json --project demo-amanah-kasir --only auth,firestore,functions \"node ../functions/scripts/smoke-emulator.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
