rules_version = '2';

// Security Rules Amanah Kasir (multi-toko), tanpa Cloud Functions (paket Spark).
//
// Identitas dibaca dari dokumen `users/{uid}` (sumber kebenaran tunggal), BUKAN
// dari custom claims:
//   role     : 'superadmin' | 'admin' | 'kasir'
//   storeIds : toko milik user (kasir tepat 1, admin >= 1, superadmin kosong)
//   isActive : false = seluruh akses dicabut seketika
// Toko yang `isActive: false` juga menutup akses operasional ke toko itu.
//
// Biaya: tiap permintaan membaca dokumen user (dan dokumen toko bila perlu)
// lewat get(); keduanya dihitung sebagai pembacaan dokumen biasa.
//
// Prinsip:
// - Satu `match` per koleksi. Firestore memakai logika OR antar aturan yang cocok,
//   jadi aturan lebar seperti `stores/{id}/**` tidak dipakai agar tidak menimpa
//   aturan yang lebih sempit.
// - Path yang tidak cocok dengan aturan mana pun otomatis ditolak.
// - Superadmin hanya MEMBACA data operasional toko; ia tidak boleh membuat
//   transaksi/produk/pengeluaran.
// - Hanya superadmin yang boleh menulis `users`, dan hanya untuk admin/kasir
//   (superadmin dibuat lewat skrip create-superadmin, tidak dari klien).
//
// Keterbatasan yang diketahui (Firestore tidak bisa memeriksanya):
// - Tidak ada keamanan per field: kasir yang membaca produk juga melihat costPrice.
// - Kasir menulis daily_summaries lewat increment; rules tidak bisa memverifikasi
//   besarnya angka, hanya field mana yang boleh disentuh.
// - Query daftar transaksi oleh kasir wajib menyertakan where('cashierId', '==', uid).
// - Rules tidak memeriksa bahwa id di `users.storeIds` menunjuk toko yang ada;
//   id yang tidak ada tidak memberi akses apa pun.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // User punya dokumen users/{uid} dan masih aktif.
    function activeUser() {
      return signedIn() && hasUserDoc() && me().isActive == true;
    }

    function isSuperadmin() {
      return activeUser() && me().role == 'superadmin';
    }

    // Anggota toko (admin/kasir aktif), terlepas dari status tokonya. Dipakai
    // untuk membaca dokumen toko sendiri agar aplikasi bisa menjelaskan
    // "toko nonaktif" alih-alih sekadar gagal.
    function memberOf(storeId) {
      return activeUser()
          && me().role in ['admin', 'kasir']
          && me().get('storeIds', []) is list
          && storeId in me().get('storeIds', []);
    }

    function storeActive(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId))
          && get(/databases/$(database)/documents/stores/$(storeId)).data.isActive == true;
    }

    // Anggota toko yang tokonya aktif: syarat akses data operasional.
    function inStore(storeId) {
      return memberOf(storeId) && storeActive(storeId);
    }

    function isAdminOf(storeId) {
      return inStore(storeId) && me().role == 'admin';
    }

    function isKasirOf(storeId) {
      return inStore(storeId) && me().role == 'kasir';
    }

    // Admin atau kasir toko tsb (admin juga boleh mencatat transaksi).
    function isStaffOf(storeId) {
      return isAdminOf(storeId) || isKasirOf(storeId);
    }

    // Field yang berubah pada update (untuk create: semua field dokumen baru).
    function changedKeys() {
      return resource == null
          ? request.resource.data.keys()
          : request.resource.data.diff(resource.data).affectedKeys();
    }

    // Bentuk dokumen user yang boleh ditulis dari klien (admin atau kasir).
    function validUser(data) {
      return data.keys().hasOnly([
            'name', 'email', 'role', 'storeIds', 'isActive', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasAll(['name', 'email', 'role', 'storeIds', 'isActive'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && data.isActive is bool
          && data.storeIds is list
          && data.storeIds.toSet().size() == data.storeIds.size()
          && ((data.role == 'kasir' && data.storeIds.size() == 1)
              || (data.role == 'admin' && data.storeIds.size() >= 1
                  && data.storeIds.size() <= 30));
    }

    // ---------- users ----------
    // Baca diri sendiri (superadmin: semua). Tulis hanya oleh superadmin: buat
    // admin/kasir, atau ubah nama/peran/toko/isActive akun non-superadmin.
    // Email dan createdAt tidak berubah (akun Auth-nya tidak ikut berubah).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperadmin());

      allow create: if isSuperadmin()
          && validUser(request.resource.data)
          && request.resource.data.get('createdAt', request.time) == request.time
          && request.resource.data.get('updatedAt', request.time) == request.time;

      allow update: if isSuperadmin()
          && resource.data.role != 'superadmin'
          && validUser(request.resource.data)
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && (request.resource.data.get('updatedAt', null) == resource.data.get('updatedAt', null)
              || request.resource.data.updatedAt == request.time);

      allow delete: if false;
    }

    // ---------- stores ----------
    // Superadmin boleh mengaktifkan/menonaktifkan toko (isActive). Admin hanya
    // mengubah pengaturan operasional tokonya.
    match /stores/{storeId} {
      allow read: if isSuperadmin() || memberOf(storeId);

      allow create: if isSuperadmin()
          && request.resource.data.isActive is bool;

      allow update: if
          (isSuperadmin() && request.resource.data.isActive is bool)
          || (isAdminOf(storeId)
              && changedKeys().hasOnly([
                'receiptHeader', 'receiptFooter', 'taxPercent', 'scanEnabled',
                'printerName', 'printerPaperMm', 'updatedAt'
              ]));

      allow delete: if false;

      // ---------- categories ----------
      match /categories/{categoryId} {
        allow read: if isSuperadmin() || inStore(storeId);
        allow write: if isAdminOf(storeId);
      }

      // ---------- products ----------
      // Hapus produk = isActive:false, jadi dokumen tidak pernah dihapus.
      // Kasir hanya boleh MENURUNKAN stok (penjualan); menaikkan stok (void,
      // stok masuk) hanya admin.
      match /products/{productId} {
        allow read: if isSuperadmin() || inStore(storeId);
        allow create: if isAdminOf(storeId);
        allow update: if isAdminOf(storeId)
            || (isKasirOf(storeId)
                && changedKeys().hasOnly(['stock', 'updatedAt'])
                && request.resource.data.stock <= resource.data.stock);
        allow delete: if false;
      }

      // ---------- transactions ----------
      // Kasir hanya melihat transaksinya sendiri. Void: kasir hanya MENGAJUKAN
      // (field voidRequest, sekali); admin yang mengubah status menjadi 'void'.
      match /transactions/{trxId} {
        allow read: if isSuperadmin()
            || isAdminOf(storeId)
            || (isKasirOf(storeId) && resource.data.cashierId == request.auth.uid);

        allow create: if isStaffOf(storeId)
            && request.resource.data.cashierId == request.auth.uid
            && request.resource.data.status == 'paid'
            && request.resource.data.keys().hasAll([
              'receiptNo', 'cashierId', 'items', 'total', 'paymentMethod', 'status'
            ]);

        allow update:
            // Admin menyetujui void; transaksi yang sudah void tidak bisa diubah lagi.
            if (isAdminOf(storeId)
                && resource.data.status == 'paid'
                && changedKeys().hasOnly([
                  'status', 'voidReason', 'voidBy', 'voidRequest', 'updatedAt'
                ])
                && (request.resource.data.status == 'paid'
                    || (request.resource.data.status == 'void'
                        && request.resource.data.voidBy == request.auth.uid)))
            // Kasir mengajukan void atas transaksinya sendiri, hanya sekali.
            || (isKasirOf(storeId)
                && resource.data.cashierId == request.auth.uid
                && resource.data.status == 'paid'
                && !('voidRequest' in resource.data)
                && changedKeys().hasOnly(['voidRequest'])
                && request.resource.data.voidRequest.requestedBy == request.auth.uid);

        allow delete: if false;
      }

      // ---------- daily_summaries ----------
      // Kasir TULIS-SAJA (increment tidak butuh izin baca) dan tidak boleh
      // menyentuh totalExpense. Admin/superadmin membaca untuk grafik & laporan.
      match /daily_summaries/{day} {
        allow read: if isSuperadmin() || isAdminOf(storeId);

        allow create, update:
            if (isAdminOf(storeId)
                && changedKeys().hasOnly([
                  'date', 'grossSales', 'totalCost', 'totalExpense', 'discount',
                  'tax', 'txCount', 'voidCount', 'byPayment', 'updatedAt'
                ]))
            || (isKasirOf(storeId)
                && changedKeys().hasOnly([
                  'date', 'grossSales', 'totalCost', 'discount', 'tax',
                  'txCount', 'voidCount', 'byPayment', 'updatedAt'
                ]));

        allow delete: if false;
      }

      // ---------- expenses ----------
      match /expenses/{expenseId} {
        allow read: if isSuperadmin() || isAdminOf(storeId);
        allow create: if isAdminOf(storeId)
            && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdminOf(storeId);
      }

      // ---------- stock_movements (jejak, tidak bisa diubah) ----------
      match /stock_movements/{moveId} {
        allow read: if isSuperadmin() || isAdminOf(storeId);
        allow create: if isStaffOf(storeId)
            && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // ---------- shifts (P3) ----------
      match /shifts/{shiftId} {
        allow read: if isSuperadmin()
            || isAdminOf(storeId)
            || (isKasirOf(storeId) && resource.data.cashierId == request.auth.uid);
        allow create: if isStaffOf(storeId)
            && request.resource.data.cashierId == request.auth.uid;
        allow update: if isStaffOf(storeId)
            && resource.data.cashierId == request.auth.uid;
        allow delete: if false;
      }

      // ---------- activity_logs & weekly_reports (tidak bisa ditulis klien) ----------
      // Disiapkan untuk Cloud Functions; belum terisi selama memakai paket Spark.
      match /activity_logs/{logId} {
        allow read: if isSuperadmin() || isAdminOf(storeId);
        allow write: if false;
      }

      match /weekly_reports/{weekId} {
        allow read: if isSuperadmin() || isAdminOf(storeId);
        allow write: if false;
      }
    }

    // Ringkasan semua toko untuk superadmin (collection group query, PRD F-25).
    match /{path=**}/daily_summaries/{day} {
      allow read: if isSuperadmin();
    }
  }
}
